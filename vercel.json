      "schedule": "17 7 * * *"
    }
  ],
  "functions": {
    "api/editorial-cron.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/storia-dei-campionati",
      "destination": "/index.html"
    }
  ]
}
